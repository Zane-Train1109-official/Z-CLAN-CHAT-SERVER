class SecurityBot:
    def __init__(self, name, location):
        self.name = name
        self.location = location
        self.alert_level = 0

    def patrol(self):
        # Logic for patrolling the area
        print(f"{self.name} is patrolling {self.location}.")

    def detect_intrusion(self):
        # Logic for detecting intrusions
        print(f"{self.name} is detecting intrusions in {self.location}.")
        # Example: check sensors, cameras, etc.

    def raise_alarm(self):
        # Logic for raising an alarm
        self.alert_level += 1
        print(f"ALERT: {self.name} has raised the alarm to level {self.alert_level} in {self.location}.")

# Example usage:
security_bot1 = SecurityBot("Bot1", "Main Entrance")
security_bot2 = SecurityBot("Bot2", "Perimeter Fence")

security_bot1.patrol()
security_bot2.patrol()

security_bot1.detect_intrusion()
security_bot2.detect_intrusion()

security_bot1.raise_alarm()
security_bot2.raise_alarm()